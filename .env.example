NODE_ENV=
APP_NAME=
# Web app origin: OAuth redirects target it and it's the backend's only allowed CORS origin
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
# Neon: postgres://…?sslmode=require  |  local PGlite: postgres://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_URL=
# Upstash Redis REST API (free tier): bot de-duplication and rate limiting. Optional: falls back to memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JWT_SECRET=
# Access token lifetime in seconds (default 86400 = 24h)
JWT_EXPIRES_IN=86400
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Support bot (docs/ARCHITECTURE.md §9). Without the two Telegram keys the bot is disabled.
TELEGRAM_BOT_TOKEN=
# 1–256 chars of A-Z a-z 0-9 _ -; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Primary LLM: Cloudflare Workers AI (free 10k neurons/day, no training on inputs)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Fallback LLM: Groq free tier (optional)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SUPPORT_BOT_RATE_LIMIT_PER_HOUR=10
# GitHub issues for support reports (use a PRIVATE repo; fine-grained token with Issues: write)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Observability (docs/ARCHITECTURE.md §10). /metrics needs this bearer token in production
METRICS_TOKEN=
# Axiom log shipping (optional): edge domain from Axiom settings, dataset and ingest token
AXIOM_DOMAIN=
AXIOM_DATASET=
AXIOM_TOKEN=
# Mobile (apps/mobile/.env.local): backend URL reachable from the phone, e.g. http://192.168.0.10:4000
EXPO_PUBLIC_API_URL=
